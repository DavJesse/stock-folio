erDiagram

    %% Relationships
    users ||--o{ transactions : has
    users ||--o{ sessions : creates
    users ||--|| portfolios : owns
    portfolios ||--o{ accounts : contains
    accounts ||--o{ transactions : performs
    stocks ||--o{ transactions : involves

    %% Tables

    users {
        INTEGER id PK
        TEXT email "UNIQUE"
        TEXT password_hash
        DATETIME created_at
    }

    portfolios {
        INTEGER id PK
        INTEGER user_id FK "REFERENCES users(id)"
        TEXT name
        DATETIME created_at
    }

    accounts {
        INTEGER id PK
        INTEGER portfolio_id FK "REFERENCES portfolios(id)"
        TEXT account_type
        REAL balance
        DATETIME created_at
    }

    sessions {
        INTEGER id PK
        INTEGER user_id FK "REFERENCES users(id)"
        TEXT token
        DATETIME expires_at
        DATETIME created_at
    }

    stocks {
        INTEGER id PK
        TEXT ticker "UNIQUE"
        TEXT company_name
        REAL last_price
        DATETIME updated_at
    }

  transactions {
      INTEGER id PK
      INTEGER user_id FK "REFERENCES users(id) ON DELETE CASCADE"
      TEXT symbol
      INTEGER quantity   
      REAL price
      TEXT type      
      DATETIME created_at
  }
