{
  "compilerOptions": {
    "target": "ES2017", // Specify ECMAScript target version
    "lib": ["dom", "dom.iterable", "esnext"], // Include library files for DOM and latest ECMAScript features
    "allowJs": true, // Allow JavaScript files to be compiled
    "skipLibCheck": true, // Skip type checking of declaration files for faster builds
    "strict": true, // Enable all strict type-checking options
    "noEmit": true, // Do not emit output files (useful for type-checking only)
    "esModuleInterop": true, // Enables emit interoperability between CommonJS and ES Modules
    "module": "esnext", // Specify module code generation
    "moduleResolution": "bundler", // Use bundler-compatible module resolution
    "resolveJsonModule": true, // Allow importing .json files as modules
    "isolatedModules": true, // Ensure each file can be safely transpiled without relying on other imports
    "jsx": "react-jsx", // Use the new JSX transform (React 17+)
    "incremental": true, // Enable incremental compilation for faster rebuilds
    "plugins": [
      {
        "name": "next" // Next.js TypeScript plugin for improved DX
      }
    ],
    "paths": {
      "@/*": ["./src/*"] // Path alias for cleaner imports
    }
  },
  "include": [
    "next-env.d.ts", // Next.js environment types
    "**/*.ts", // Include all TypeScript files
    "**/*.tsx", // Include all TSX (React) files
    ".next/types/**/*.ts" // Include Next.js generated types
  ],
  "exclude": [
    "node_modules" // Exclude dependencies
  ]
}
